# Landing app cross-app redirect URLs.
# Used after a successful role-based login to send the user into the right portal.
#
# Local development defaults (matching the npm run dev ports):
VITE_STUDENT_URL=http://localhost:5174
VITE_MENTOR_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5176
#
# Vercel production — set these as environment variables in the Vercel
# project settings for the deployed landing app:
# VITE_STUDENT_URL=https://<student-production-domain>
# VITE_MENTOR_URL=https://<mentor-production-domain>
# VITE_ADMIN_URL=https://<admin-production-domain>
