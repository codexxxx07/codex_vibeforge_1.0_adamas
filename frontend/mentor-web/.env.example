# Mentor web cross-app redirect URL (back to the landing app).
# Used for failed-authentication redirects, logout, and returning home.
#
# Local development default (matching the npm run dev port of the landing app):
VITE_LANDING_URL=http://localhost:5173
#
# Vercel production — set this as an environment variable in the Vercel
# project settings for the deployed mentor-web app:
# VITE_LANDING_URL=https://<landing-production-domain>
